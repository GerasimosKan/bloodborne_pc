<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BloodborneLauncher</AssemblyName>
    <RootNamespace>BloodborneLauncher</RootNamespace>
    <ApplicationIcon>Assets/bloodborne.ico</ApplicationIcon>
    <!-- Only affects single-file publishes: the bundled .NET runtime is compressed. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/*.png" />
    <Resource Include="Assets/*.jpg" />
    <Resource Include="Assets/bloodborne.ico" />
    <!-- bbport 0.7's settings (Store.cs): the schema the Linux launcher and bbport-run.exe share. -->
    <EmbeddedResource Include="../../launcher/settings_schema.json" LogicalName="settings_schema.json" />
  </ItemGroup>
</Project>
